# Supabase project URL and anon (public) key, used only to sign users in
# with Supabase Auth (Google). The anon key is designed to be public;
# the frontend never reads/writes database tables with it directly --
# all data goes through the Django API below.
# Supabase dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Django API.
# Local dev: http://localhost:8000
# Production: leave empty -- Django serves the built frontend itself, so
# API requests use the same origin.
VITE_API_URL=http://localhost:8000
