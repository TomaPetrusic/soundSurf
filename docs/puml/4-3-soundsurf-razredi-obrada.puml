@startuml
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam classAttributeIconSize 0
skinparam linetype ortho
left to right direction

title soundSurf - UML razredi: radna okolina, generiranje i obrada zvuka

package "Domenski model" {
  class "RadnaOkolina" as Okolina {
    +id: long
    +korisnikId: long
  }
  abstract class "StavkaRadneOkoline" as Stavka {
    +id: long
    +vlasnikId: long
    +roditeljId: long [0..1]
    +naziv: String
    +preimenuj(noviNaziv: String): void
    +premjesti(ciljnaMapaId: long [0..1]): void
  }
  class "Direktorij" as Direktorij {
    +obrisiRekurzivno(): void
  }
  class "ZvukovnaDatoteka" as Zvuk {
    +format: AudioFormat
    +kljucSadrzaja: String
    +velicinaBajtova: long
    +trajanjeSekundi: double
    +sampleRate: int
    +kanali: int
    +porijeklo: Porijeklo
    +zamijeniSadrzaj(kljuc: String): void
  }
  class "ParametriFiltra" as Parametri {
    +vrsta: VrstaFiltra
    +vrijednosti: Map
    +provjeri(): void
  }
  class "ParametriOscilatora" as OscParam {
    +oblik: OblikVala
    +frekvencijaHz: double
    +trajanjeSekundi: double
    +amplituda: double
    +provjeri(): void
  }
  enum "OblikVala" as Wave {
    SINUS
    KVADRAT
    PILA
    TROKUT
  }
  enum "VrstaFiltra" as Vrsta {
    NISKOPROPUSNI
    VISOKOPROPUSNI
    POJACANJE
    REVERB
    TREMOLO
  }
  enum "NacinSpremanja" as Nacin {
    NOVA_DATOTEKA
    PREPISI_IZVOR
  }
  enum "AudioFormat" as Format {
    WAV
    MP3
    FLAC
  }
  enum "Porijeklo" as Porijeklo {
    UPLOAD
    FREESOUND
    GENERATED
    COPY
  }
}

package "Aplikacijska logika i sučelja" {
  class "UslugaRadneOkoline" as WS <<service>> {
    +stablo(korisnikId: long): List<StavkaRadneOkoline>
    +stvoriMapu(korisnikId: long, naziv: String, roditeljId: long [0..1]): Direktorij
    +ucitaj(korisnikId: long, sadrzaj: bytes, naziv: String, roditeljId: long [0..1]): ZvukovnaDatoteka
    +preuzmi(korisnikId: long, datotekaId: long, format: AudioFormat [0..1]): bytes
    +preimenujIliPremjesti(korisnikId: long, stavkaId: long, naziv: String [0..1], roditeljId: long [0..1]): StavkaRadneOkoline
    +obrisi(korisnikId: long, stavkaId: long): void
    +prepisiSadrzaj(korisnikId: long, datotekaId: long, sadrzaj: bytes): ZvukovnaDatoteka
  }
  class "UslugaObradeZvuka" as Obrada <<service>> {
    +pripremiPregled(korisnikId: long, datotekaId: long, parametri: ParametriFiltra): Pregled
    +spremiRezultat(korisnikId: long, pregledId: UUID, nacin: NacinSpremanja): ZvukovnaDatoteka
  }
  class "UslugaGeneriranjaZvuka" as Gen <<service>> {
    +generiraj(korisnikId: long, ciljDirektorijId: long, naziv: String, parametri: ParametriOscilatora): ZvukovnaDatoteka
  }
  interface "RepozitorijZapisa" as Repo {
    +dohvati(id: long): StavkaRadneOkoline
    +spremi(stavka: StavkaRadneOkoline): void
  }
  interface "SpremisteSadrzaja" as Store {
    +spremi(kljuc: String, sadrzaj: bytes, mimeTip: String): void
    +procitaj(kljuc: String): bytes
    +obrisi(kljucevi: List<String>): void
    +potpisaniUrl(kljuc: String, trajanjeSekundi: int): String
  }
  class "SupabaseSpremiste" as Supa
  class "LokalnoSpremiste" as Lokal
  interface "ProcesorZvuka" as Procesor {
    +primijeniFiltar(sadrzaj: bytes, parametri: ParametriFiltra): bytes
  }
}

Stavka <|-- Direktorij
Stavka <|-- Zvuk
Direktorij "0..1" o-- "0..*" Stavka : sadrži
Zvuk --> Format
Zvuk --> Porijeklo
Parametri --> Vrsta
OscParam --> Wave
Store <|.. Supa
Store <|.. Lokal
WS ..> Repo : metapodaci
WS ..> Store : sadržaj
WS ..> Okolina : početni zapisi (F-02)
Gen ..> OscParam
Gen ..> WS : sprema novu datoteku
Obrada ..> Parametri : validira
Obrada ..> Nacin
Obrada ..> WS : sprema / prepisuje datoteku
Obrada ..> Store : čita izvorni sadržaj
Obrada ..> Procesor : računa filtar

note bottom of Stavka
  Direktorij i ZvukovnaDatoteka implementirani su kao jedna
  tablica workspace_node s poljem tip (mapa / datoteka).
  Vlasništvo se provjerava na svakoj stavci (vlasnikId);
  tuđa stavka ponaša se kao da ne postoji.
  premjesti() vrijedi za datoteke (F-10) i za mape;
  mapa se ne može premjestiti u samu sebe ni u svoju podmapu.
end note
note bottom of WS
  Implementacija: Django aplikacija "workspace"
  (rute /api/workspace/...). RepozitorijZapisa ostvaruje Django ORM.
  F-04..F-11, F-15, F-02.
  prepisiSadrzaj (F-15): novi sadržaj sprema se pod novi ključ,
  zatim se ažurira zapis, a stari sadržaj briše se tek nakon uspjeha.
end note
note bottom of Obrada
  Projektni prijedlog za UC-02, UC-06 i UC-07.
  Otvoreno pitanje za tim: obrada na poslužitelju (ovaj prijedlog)
  ili u pregledniku (postojeći frontend/src/services/audio.js).
  U oba slučaja konačno spremanje ide preko UslugaRadneOkoline.
  Pregled je privremeni rezultat prije konačne pohrane.
end note
@enduml
