@startuml
left to right direction
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam linetype ortho
hide circle

title soundSurf - model trajnih podataka

entity "Korisnik\n(accounts_userprofile)" as Korisnik {
  * id : broj <<PK>>
  --
  * supabase_user_id : UUID <<UNIQUE>>
  * email : tekst
  display_name : tekst
  bio : tekst
  * created_at : datum_vrijeme
  * updated_at : datum_vrijeme
}
entity "Radna okolina\n(workspace_workspace)" as Okolina {
  * id : broj <<PK>>
  --
  * korisnik_id : broj <<FK, UNIQUE>>
  * created_at : datum_vrijeme
}
entity "Stavka radne okoline\n(workspace_node)" as Stavka {
  * id : broj <<PK>>
  --
  * vlasnik_id : broj <<FK>>
  roditelj_id : broj <<FK, NULL>>
  * naziv : tekst
  * tip : mapa / datoteka
  .. samo za datoteke ..
  format : WAV / MP3 / FLAC
  storage_key : tekst <<UNIQUE>>
  size_bytes : broj
  trajanje_s : broj
  sample_rate : broj
  kanali : broj
  origin_type : upload / freesound / generated / copy
  --
  * created_at : datum_vrijeme
  * updated_at : datum_vrijeme
}
entity "Javni profil" as Profil {
  * korisnik_id : broj <<PK, FK>>
  --
  * korisnicko_ime : tekst
  avatar_storage_key : tekst
  kratki_opis : tekst
}
entity "Post" as Post {
  * id : UUID <<PK>>
  --
  * autor_id : broj <<FK>>
  * zvuk_id : broj <<FK>>
  * tekstualni_opis : tekst
  * javan : boolean
  * created_at : datum_vrijeme
}
entity "Favorit profila" as FavProfil {
  * korisnik_id : broj <<PK, FK>>
  * profil_korisnik_id : broj <<PK, FK>>
}
entity "Favorit posta" as FavPost {
  * korisnik_id : broj <<PK, FK>>
  * post_id : UUID <<PK, FK>>
}

Korisnik "1" -- "0..1" Okolina : ima
Korisnik "1" -- "0..*" Stavka : posjeduje
Stavka "0..1" -- "0..*" Stavka : nadređena mapa / sadržaj
Korisnik "1" -- "1" Profil : uređuje
Korisnik "1" -- "0..*" Post : objavljuje
Stavka "1" -- "0..*" Post : zvuk (tip = datoteka)
Korisnik "1" -- "0..*" FavProfil : označava
Profil "1" -- "0..*" FavProfil : cilj
Korisnik "1" -- "0..*" FavPost : označava
Post "1" -- "0..*" FavPost : cilj

note bottom of Stavka
  Mape i datoteke čuvaju se u jednoj tablici; razlikuje ih polje tip.
  roditelj_id = NULL znači korijen radne okoline.
  F-07/F-09: naziv je jedinstven unutar iste mape istog korisnika,
  uključujući korijen (provodi baza, UNIQUE s NULLS NOT DISTINCT).
  Datoteka mora imati storage_key (provodi baza, CHECK).
  F-04/F-06: WAV, MP3, FLAC.
  F-11: brisanjem mape brišu se sve stavke u njoj i njihov sadržaj.
  Bajtovi zvuka čuvaju se u Supabase Storageu (bucket audio-files)
  pod ključem <supabase_user_id>/<uuid>.<ext>; naziv i mapa
  postoje samo u bazi, pa preimenovanje i premještanje ne diraju sadržaj.
  Kopija tuđeg zapisa (F-29) dobiva vlastiti ID i storage_key
  i ne ovisi o izvornom postu.
  RLS je uključen na tablicama; pristup ide isključivo preko Django API-ja.
end note
note bottom of Okolina
  Bilježi da je korisnik pri prvom otvaranju radne okoline
  dobio tri početna zapisa (F-02), pa se ne dodjeljuju ponovno.
end note
note bottom of Korisnik
  Stvara se pri prvoj prijavi preko Supabase Autha (Google).
  Lozinka se ne pohranjuje (NF-06).
end note
note bottom of Post
  F-21: privatni post vidi samo njegov autor.
  F-22: brisanjem posta uklanjaju se favoriti posta.
  Otvorena odluka: brisanje izvornog zapisa
  vezanog uz post (snapshot ili zabrana brisanja).
end note
@enduml
