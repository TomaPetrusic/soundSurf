# Postgres connection string for the Supabase project's database.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# If the password contains special characters (e.g. "%" or "/"), they do
# not need to be percent-encoded here -- the backend normalizes them.
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Base Supabase project URL (no /rest/v1 suffix). Used to fetch the
# project's JWKS to verify Supabase Auth tokens.
# Supabase dashboard -> Project Settings -> API -> Project URL.
SUPABASE_URL=https://your-project.supabase.co

# Optional: only set this if the Supabase project still uses the legacy
# shared HS256 JWT secret instead of the newer JWKS signing keys.
# Supabase dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret.
SUPABASE_JWT_SECRET=

# Django settings.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
